# Anthropic API key — required for real runs. Mock backend used if unset.
ANTHROPIC_API_KEY=sk-ant-...

# Model. `claude-sonnet-4-5-20250929` is a working public API ID.
# NOTE: `claude-sonnet-4-6` is a Claude Code alias, not a public API ID.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Max output tokens per model turn.
MAX_TOKENS=1024
